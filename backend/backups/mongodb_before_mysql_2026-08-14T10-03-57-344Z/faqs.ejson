[{"_id":{"$oid":"6a678d451061a8c117cfcad8"},"question":"Chatbot AI có thể trả lời khách hàng 24/7 không?","answer":"Có. Chatbot AI có thể tự động trả lời tin nhắn khách hàng mọi lúc, giúp doanh nghiệp tiết kiệm thời gian và tăng tỷ lệ chuyển đổi.","page":"home","order":{"$numberInt":"1"}},{"_id":{"$oid":"6a678d451061a8c117cfcad9"},"question":"Chatbot AI có hỗ trợ Facebook Messenger không?","answer":"Có. Hệ thống hỗ trợ tích hợp Facebook Messenger để tự động tư vấn và chăm sóc khách hàng.","page":"home","order":{"$numberInt":"2"}},{"_id":{"$oid":"6a678d451061a8c117cfcada"},"question":"Doanh nghiệp nhỏ có nên sử dụng chatbot AI không?","answer":"Chatbot AI phù hợp với cả doanh nghiệp nhỏ và lớn nhờ khả năng tự động hóa quy trình chăm sóc khách hàng.","page":"home","order":{"$numberInt":"3"}},{"_id":{"$oid":"6a678d451061a8c117cfcadb"},"question":"Giải pháp Chatbot AI hoạt động như thế nào?","answer":"Chatbot AI được huấn luyện dựa trên dữ liệu doanh nghiệp để có thể trả lời chính xác các câu hỏi của khách hàng.","page":"solutions","serviceDetail":"chatbot","order":{"$numberInt":"1"}},{"_id":{"$oid":"6a678d451061a8c117cfcadc"},"question":"Chatbot AI có thể tích hợp website không?","answer":"Có. Chatbot có thể tích hợp trực tiếp vào website, landing page hoặc ứng dụng của doanh nghiệp.","page":"solutions","serviceDetail":"chatbot","order":{"$numberInt":"2"}},{"_id":{"$oid":"6a678d451061a8c117cfcadd"},"question":"Chatbot AI có học từ dữ liệu doanh nghiệp không?","answer":"Có. Hệ thống có thể được đào tạo dựa trên tài liệu, sản phẩm và quy trình của doanh nghiệp.","page":"solutions","serviceDetail":"chatbot","order":{"$numberInt":"3"}},{"_id":{"$oid":"6a678d451061a8c117cfcade"},"question":"CRM AI giúp quản lý khách hàng như thế nào?","answer":"CRM AI giúp lưu trữ thông tin khách hàng, quản lý lịch sử tương tác và tự động phân loại khách hàng tiềm năng.","page":"solutions","serviceDetail":"crm","order":{"$numberInt":"4"}},{"_id":{"$oid":"6a678d451061a8c117cfcadf"},"question":"CRM AI có thể đồng bộ dữ liệu từ nhiều nguồn không?","answer":"Có. CRM AI có thể đồng bộ dữ liệu từ website, chatbot, Facebook và các kênh khác.","page":"solutions","serviceDetail":"crm","order":{"$numberInt":"5"}},{"_id":{"$oid":"6a678d451061a8c117cfcae0"},"question":"Marketing AI có thể hỗ trợ chiến dịch quảng cáo không?","answer":"Marketing AI hỗ trợ phân tích dữ liệu và đề xuất các chiến dịch quảng cáo phù hợp với tệp khách hàng mục tiêu.","page":"solutions","serviceDetail":"marketing","order":{"$numberInt":"6"}},{"_id":{"$oid":"6a678d451061a8c117cfcae1"},"question":"Marketing AI có hỗ trợ gửi email tự động không?","answer":"Có. Hệ thống hỗ trợ xây dựng kịch bản gửi email marketing tự động cho khách hàng.","page":"solutions","serviceDetail":"marketing","order":{"$numberInt":"7"}},{"_id":{"$oid":"6a678d451061a8c117cfcae2"},"question":"Có những gói dịch vụ nào?","answer":"Chúng tôi cung cấp nhiều gói dịch vụ phù hợp với nhu cầu của từng doanh nghiệp từ cơ bản đến nâng cao.","page":"pricing","order":{"$numberInt":"0"},"serviceDetail":"chatbot","updatedAt":{"$date":{"$numberLong":"1785171338302"}}},{"_id":{"$oid":"6a678d451061a8c117cfcae3"},"question":"Có những gói dịch vụ nào?","answer":"Chúng tôi cung cấp nhiều gói dịch vụ phù hợp với nhu cầu của từng doanh nghiệp từ cơ bản đến nâng cao.","page":"pricing","order":{"$numberInt":"0"},"serviceDetail":"chatbot","updatedAt":{"$date":{"$numberLong":"1785171342679"}}},{"_id":{"$oid":"6a678d451061a8c117cfcae4"},"question":"Có những gói dịch vụ nào?","answer":"Chúng tôi cung cấp nhiều gói dịch vụ phù hợp với nhu cầu của từng doanh nghiệp từ cơ bản đến nâng cao.","page":"pricing","order":{"$numberInt":"0"},"serviceDetail":"marketing","updatedAt":{"$date":{"$numberLong":"1785171350729"}}},{"_id":{"$oid":"6a678d451061a8c117cfcae5"},"question":"Bài viết trên blog có được cập nhật thường xuyên không?","answer":"Chúng tôi liên tục cập nhật các kiến thức, xu hướng AI và các hướng dẫn hữu ích cho doanh nghiệp.","page":"blog","order":{"$numberInt":"1"}},{"_id":{"$oid":"6a678d451061a8c117cfcae6"},"question":"Blog có chia sẻ kinh nghiệm triển khai chatbot AI không?","answer":"Có. Blog cung cấp nhiều bài viết về cách triển khai chatbot AI hiệu quả cho từng lĩnh vực.","page":"blog","order":{"$numberInt":"2"}},{"_id":{"$oid":"6a678d451061a8c117cfcae7"},"question":"Tôi có thể tìm tài liệu hướng dẫn sử dụng ở đâu?","answer":"Bạn có thể tham khảo các bài viết hướng dẫn chi tiết được đăng tải trong chuyên mục Blog.","page":"blog","order":{"$numberInt":"3"}}]