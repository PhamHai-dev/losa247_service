PORT=5000
NODE_ENV=development
DATABASE_URL="mysql://losa247_app:your_password_here@127.0.0.1:3306/losa247"
JWT_ADMIN_SECRET=generate_a_unique_random_value_of_at_least_32_bytes
JWT_CLIENT_SECRET=generate_another_unique_random_value_of_at_least_32_bytes
JWT_ISSUER=losa247-api
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=false
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# URL webhook production của workflow n8n (phải là URL http/https đầy đủ)
N8N_WEBHOOK_URL=https://your-n8n.example.com/webhook/losa247-chat
N8N_CALLBACK_URL=http://localhost:5000/api/v1/webhooks/n8n/chat-reply
N8N_WEBHOOK_SECRET=generate_a_random_value_of_at_least_32_bytes
N8N_INBOUND_SECRET=
N8N_OUTBOUND_SECRET=
N8N_TIMEOUT_MS=30000
N8N_REPLAY_WINDOW_MS=300000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
CHAT_QUEUE_PREFIX=losa247
CHAT_WORKER_CONCURRENCY=5
CHAT_DEBOUNCE_MS=3000
CHAT_RECENT_MESSAGE_LIMIT=20
CHAT_JOB_ATTEMPTS=4
CHAT_JOB_BACKOFF_MS=2000
OUTBOX_POLL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=20
# false ở production để chạy worker bằng process riêng
RUN_CHAT_WORKERS_IN_API=true
